<!DOCTYPE html>
<html lang="pt-br">
<head><meta charset="UTF-8"><title>Painel</title></head>
<body>
    <h2>Olá, <%= nome %>! | <a href="/logout">Sair</a></h2>
    <h3>Usuários Cadastrados</h3>
    <table border="1" cellpadding="5">
        <tr>
            <th>Nome</th>
            <th>E-mail</th>
            <th>Ações</th>
        </tr>
        <% lista.forEach(user => { %>
            <tr>
                <form action="/editar/<%= user._id %>" method="POST">
                    <td><input type="text" name="nome" value="<%= user.nome %>"></td>
                    <td><input type="email" name="email" value="<%= user.email %>"></td>
                    <td>
                        <button type="submit">Atualizar</button>
                        <a href="/deletar/<%= user._id %>">Excluir</a>
                    </td>
                </form>
            </tr>
        <% }) %>
    </table>
</body>
</html>